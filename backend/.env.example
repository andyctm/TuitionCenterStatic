# Neon Postgres connection string (see docs/03-database-design.md)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Comma-separated list of allowed CORS origins (the GitHub Pages frontend origin(s))
ALLOWED_ORIGINS="https://your-username.github.io"

# JWT secrets - generate distinct random values per environment, never reuse dev secrets in prod
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# Shared secret for internal/system endpoints (e.g. the session-materialization cron job)
INTERNAL_JOB_SECRET="change-me"

# Transactional email (password reset only)
EMAIL_API_KEY="change-me"

PORT=4000
NODE_ENV="development"
